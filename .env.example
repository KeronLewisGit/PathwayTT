APP_NAME=PathwayTT
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Store UTC, display Atlantic Standard Time (Trinidad & Tobago, no DST).
APP_DISPLAY_TIMEZONE=America/Port_of_Spain

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pathwaytt
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database

# Background jobs (resume parsing, match recomputation, gap plans, job sync).
# "database" needs either `php artisan queue:work` or, on shared hosting,
# the scheduler fallback below driven by a single cron entry running
# `php artisan schedule:run` every minute.
QUEUE_CONNECTION=database
QUEUE_VIA_SCHEDULER=true

# Email (verification, password resets). "log" writes emails to storage/logs;
# for a tester instance point MAIL_* at a real SMTP account (or Mailpit).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Email verification: false = reminder banner, users may proceed; true = required.
REQUIRE_EMAIL_VERIFICATION=false

# Tester instances: seed the demo accounts/listings, and tell new sign-ups where
# captured email can be read (e.g. Mailpit) when MAIL_MAILER isn't real SMTP.
APP_DEMO_DATA=false
APP_DEMO_MAIL_UI=

# Resume structuring: "rule" needs no key; "llm" uses the Anthropic API.
RESUME_PARSER_DRIVER=rule
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Remote job boards pulled by `php artisan job:sync` (see config/jobsources.php).
JOBSOURCE_REMOTIVE=true
JOBSOURCE_JOBICY=true
JOBSOURCE_HIMALAYAS=true
JOBSOURCE_REMOTEOK=false
JOBSOURCE_ARBEITNOW=false
JOBSOURCE_MAX_PER_SOURCE=500
# Live feed: hide [DEMO] listings (false) and queue a refresh when older than N minutes.
JOBSOURCE_SHOW_DEMO=false
JOBSOURCE_AUTO_REFRESH_MINUTES=60
JOBSOURCE_IMPORT_INELIGIBLE=false

VITE_APP_NAME="${APP_NAME}"
